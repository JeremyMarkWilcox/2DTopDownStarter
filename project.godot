; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2DTopDownStarter"
run/main_scene="res://Game/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

MenuManager="*res://addons/CoreUI/Scripts/MenuManager.cs"
SceneFlowManager="*res://Configuration/SceneFlow.tscn"
SettingsManager="*res://addons/CoreUI/Scripts/SettingsManager.cs"
AudioManager="*res://addons/CoreUI/Scenes/Audio.tscn"
PauseController="*res://addons/CoreUI/Scripts/PauseController.cs"
InputManager="*res://addons/CoreUI/Scripts/InputManager.cs"
SaveManager="*res://addons/CoreUI/Scripts/SaveManager.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=640
window/size/min_height=360
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Main Menu"

[editor_plugins]

enabled=PackedStringArray()

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":4194321), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":4194323), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":4194320), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":4194322), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}


ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305)
, Object(InputEventJoypadButton,"device":-1,"button_index":1)
, Object(InputEventJoypadButton,"device":-1,"button_index":6)
]
}
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309)
, Object(InputEventKey,"keycode":4194310)
, Object(InputEventKey,"keycode":32)
, Object(InputEventJoypadButton,"device":-1,"button_index":0)
]
}
save_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194336,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":0,"button_index":3,"pressure":0.0,"pressed":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
